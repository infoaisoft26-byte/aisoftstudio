# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT=3000

# SESSION_SECRET: Secret for signing session tokens (will use random fallback if unset)
SESSION_SECRET="aisoft_studio_secure_session_secret_2026"

# Meta Developer Integration (Optional - configure in Admin Meta Center or here)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="aisoft_meta_verify_2026"
META_PAGE_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Razorpay Payment Gateway Integration (Configured in Admin Finance Center or here)
# Obtain from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
